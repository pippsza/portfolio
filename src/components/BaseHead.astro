---
import type { Locale } from '../constants/data';

interface Props {
  title: string;
  description: string;
  lang: Locale;
}

const { title, description, lang } = Astro.props;

const siteUrl = 'https://pippsza.dev';
const fullCanonical = `${siteUrl}${Astro.url.pathname}`;
// Social networks need a PNG preview
const ogImage = `${siteUrl}/og-image.png`;

// Map locale codes to proper language tags
const langMap: Record<Locale, string> = {
  en: 'en-US',
  uk: 'uk-UA',
  ru: 'ru-RU',
};
---

<!-- Primary Meta Tags -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Canonical URL -->
<link rel="canonical" href={fullCanonical} />

<!-- Language alternates -->
<link rel="alternate" hreflang="en" href={`${siteUrl}/en${Astro.url.pathname.replace(/^\/(en|uk|ru)/, '')}`} />
<link rel="alternate" hreflang="uk" href={`${siteUrl}/uk${Astro.url.pathname.replace(/^\/(en|uk|ru)/, '')}`} />
<link rel="alternate" hreflang="ru" href={`${siteUrl}/ru${Astro.url.pathname.replace(/^\/(en|uk|ru)/, '')}`} />
<link rel="alternate" hreflang="x-default" href={`${siteUrl}/en${Astro.url.pathname.replace(/^\/(en|uk|ru)/, '')}`} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={fullCanonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Bohdan Astakhov, Full Stack Developer" />
<link rel="image_src" href={ogImage} />
<meta property="og:locale" content={langMap[lang]} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={fullCanonical} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content="Bohdan Astakhov, Full Stack Developer" />

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<meta name="theme-color" content="#ffffff" />

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&display=swap" rel="stylesheet" />
