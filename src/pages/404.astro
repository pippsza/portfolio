---
import Layout from '../layouts/Layout.astro';
import { dictionary } from '../constants/data';

const t = dictionary.en;
---

<Layout title={`404 | ${t.notFound}`} description={t.notFoundText} lang="en">
  <main>
    <h1>{t.notFound}</h1>
    <p>{t.notFoundText}</p>
    <p><a href="/en/">{t.home}</a></p>
  </main>
</Layout>

<style>
  main {
    max-width: 600px;
    margin: 0 auto;
    padding: 120px 24px;
  }

  h1 {
    font-size: 44px;
    margin: 0 0 16px;
  }
</style>
