---
import Layout from '../../layouts/Layout.astro';
import { dictionary, projects, skills, socials, experience, cvLinks, cvPreviews, type Locale } from '../../constants/data';
import Icon from '../../components/Icon';
import DevOpsPipeline from '../../components/DevOpsPipeline';
import ProjectCard from '../../components/ProjectCard';
import ExperienceCard from '../../components/ExperienceCard';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'uk' } },
    { params: { lang: 'ru' } },
  ];
}

const { lang } = Astro.params as { lang: Locale };
const t = dictionary[lang];
const localizedProjects = projects[lang];
const localizedExperience = experience[lang];
const cvHref = cvLinks[lang];
const cvPreview = cvPreviews[lang];
const projectIcons = ['Rocket', 'Sparkles', 'Bot', 'Network', 'Brain', 'Send'];
---

<Layout title={`Astakhov Bohdan | pippsza - Full Stack Developer`} description={`${t.heroDescription} | Portfolio of Astakhov Bohdan (@pippsza)`} lang={lang}>
  <!-- Hero Section -->
  <section class="relative min-h-screen flex items-center justify-center px-6 py-14">
    <div class="container mx-auto relative z-10">
      <div class="flex flex-col lg:flex-row items-center justify-center gap-12 lg:gap-20">

        <!-- Photo -->
        <div class="relative animate-fade-in-up order-1 lg:order-2" style="animation-delay: 0.15s;">
          <div class="hero-photo-glow"></div>
          <div class="hero-photo">
            <img
              src="/avatar.jpg"
              alt="Astakhov Bohdan"
              width="300"
              height="300"
              loading="eager"
            />
          </div>
        </div>

        <!-- Text Content -->
        <div class="text-center lg:text-left space-y-6 order-2 lg:order-1 max-w-2xl">
          <div class="animate-fade-in-up" style="animation-delay: 0s;">
            <p class="text-accent font-medium text-lg mb-2">{t.greeting}</p>
            <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold">
              <span class="text-gradient-animated">Astakhov Bohdan</span>
            </h1>
          </div>

          <p class="text-xl md:text-2xl font-semibold text-text-muted animate-fade-in-up" style="animation-delay: 0.1s;">
            {t.role}
          </p>

          <p class="text-base md:text-lg text-text-muted leading-relaxed animate-fade-in-up" style="animation-delay: 0.2s;">
            {t.heroDescription}
          </p>

          <div class="grid grid-rows-3 sm:flex sm:flex-wrap w-full gap-4 justify-center lg:justify-start animate-fade-in-up" style="animation-delay: 0.3s;">
            <a
              href={`/${lang}/#contact`}
              data-magnetic
              class="inline-flex w-full sm:w-fit items-center gap-2 px-6 py-3 rounded-lg bg-accent text-surface font-semibold
                     hover:bg-accent-hover transition-all duration-300 hover:shadow-lg hover:shadow-accent/30 btn-hover"
            >
              <Icon name="Mail" size={20} client:load />
              {t.contactMe}
            </a>
            <a
              href={`/${lang}/#projects`}
              class="inline-flex w-full sm:w-fit items-center gap-2 px-6 py-3 rounded-lg border border-border
                     text-text-dark font-semibold hover:border-accent hover:text-accent
                     transition-all duration-300"
            >
              <Icon name="Layers" size={20} client:load />
              {t.viewProjects}
            </a>
            <a
              href={cvHref}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex w-full sm:w-fit items-center gap-2 px-6 py-3 rounded-lg border border-border
                     text-text-dark font-semibold hover:border-accent hover:text-accent
                     transition-all duration-300"
            >
              <Icon name="Download" size={20} client:load />
              {t.downloadCV}
            </a>
          </div>

          <!-- Social Links -->
          <div class="flex gap-4 justify-center lg:justify-start pt-4 animate-fade-in-up" style="animation-delay: 0.4s;">
            {socials.map((social, index) => (
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                class="p-3 rounded-xl border border-border/50 bg-surface/30 backdrop-blur-sm
                       hover:border-accent hover:bg-accent/10 hover:scale-110
                       transition-all duration-300 group"
                aria-label={social.name}
                title={social.name}
                style={`animation-delay: ${0.4 + index * 0.1}s`}
              >
                <Icon name={social.iconName} size={22} class="text-text-muted group-hover:text-accent transition-colors duration-300" client:load />
              </a>
            ))}
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- About Section -->
  <section id="about" class="py-24 px-6">
    <div class="container mx-auto max-w-5xl">
      <div class="text-center mb-12 reveal">
        <h2 class="text-3xl md:text-5xl font-bold">
          <span class="text-accent">{t.aboutTitle.split(' ')[0]}</span>
          {' '}{t.aboutTitle.split(' ').slice(1).join(' ')}
        </h2>
      </div>
      <div class="flex flex-col md:flex-row items-center gap-10 lg:gap-16 reveal">
        <img
          src="/about.jpg"
          alt="Astakhov Bohdan at DOU Day"
          width="320"
          height="426"
          loading="lazy"
          class="shrink-0 w-60 md:w-72 lg:w-80 rounded-2xl border border-border shadow-lg object-cover"
        />
        <p class="text-lg text-text-muted leading-relaxed text-center md:text-left">
          {t.aboutDescription}
        </p>
      </div>
    </div>
  </section>

  <!-- Resume Section -->
  <section id="resume" class="py-24 px-6">
    <div class="container mx-auto max-w-4xl">
      <div class="text-center mb-12 reveal">
        <h2 class="text-3xl md:text-5xl font-bold mb-4">
          <span class="text-accent">{t.resumeTitle.split(' ')[0]}</span>
          {' '}{t.resumeTitle.split(' ').slice(1).join(' ')}
        </h2>
        <p class="text-lg text-text-muted">{t.resumeDescription}</p>
      </div>

      <div class="flex flex-col items-center gap-8 reveal">
        <a
          href={cvHref}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={t.openResume}
          class="group relative block max-w-md rounded-xl overflow-hidden border border-border shadow-lg
                 hover:border-accent transition-all duration-300"
        >
          <img
            src={cvPreview}
            alt={t.resumeTitle}
            width="620"
            height="877"
            loading="lazy"
            class="w-full h-auto"
          />
          <div class="absolute inset-0 flex items-center justify-center bg-surface/0
                      group-hover:bg-surface/40 transition-all duration-300">
            <span class="inline-flex items-center gap-2 px-5 py-3 rounded-lg bg-accent text-surface font-semibold
                         opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              <Icon name="ExternalLink" size={20} client:load />
              {t.openResume}
            </span>
          </div>
        </a>

        <a
          href={cvHref}
          download
          class="inline-flex items-center gap-2 px-8 py-4 rounded-lg bg-accent text-surface font-semibold
                 hover:bg-accent-hover transition-all duration-300 hover:shadow-lg hover:shadow-accent/30 btn-hover"
        >
          <Icon name="Download" size={22} client:load />
          {t.downloadCV}
        </a>
      </div>
    </div>
  </section>

  <!-- Experience Section -->
  <section id="experience" class="py-24 px-6">
    <div class="container mx-auto max-w-4xl">
      <div class="text-center mb-16 reveal">
        <h2 class="text-3xl md:text-5xl font-bold mb-4">
          <span class="text-accent">{t.experienceTitle.split(' ')[0]}</span>
          {' '}{t.experienceTitle.split(' ').slice(1).join(' ')}
        </h2>
        <p class="text-lg text-text-muted">
          {t.experienceDescription}
        </p>
      </div>

      <!-- Timeline -->
      <div class="relative md:pl-8 md:border-l-2 md:border-border space-y-6">
        {localizedExperience.map((exp, index) => (
          <ExperienceCard
            experience={exp}
            index={index}
            client:load
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Projects Section -->
  <section id="projects" class="py-24 px-6">
    <div class="container mx-auto max-w-6xl">
      <div class="text-center mb-16 reveal">
        <h2 class="text-3xl md:text-5xl font-bold mb-4">
          <span class="text-accent">{t.projectsTitle.split(' ')[0]}</span>
          {' '}{t.projectsTitle.split(' ').slice(1).join(' ')}
        </h2>
        <p class="text-lg text-text-muted">
          {t.projectsDescription}
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6 lg:gap-8">
        {localizedProjects.map((project, index) => (
          <ProjectCard
            project={project}
            viewProject={t.viewProject}
            viewCode={t.viewCode}
            iconName={projectIcons[index] ?? 'Layers'}
            index={index}
            client:load
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Skills Section - Full width carousel -->
  <section id="skills" class="py-24">
    <div class="container mx-auto px-6 mb-10">
      <div class="text-center reveal">
        <h2 class="text-3xl md:text-5xl font-bold mb-4">
          <span class="text-accent">{t.skillsTitle.split(' ')[0]}</span>
          {' '}{t.skillsTitle.split(' ').slice(1).join(' ')}
        </h2>
        <p class="text-lg text-text-muted">
          {t.skillsDescription}
        </p>
      </div>
    </div>

    <!-- Static skill grid -->
    <div class="container mx-auto px-6">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {Object.entries(skills).map(([category, skillList], index) => (
          <div
            class="reveal rounded-2xl border border-border/60 bg-surface/40 p-6 backdrop-blur-sm hover-lift"
            style={`--reveal-delay:${index * 70}ms`}
          >
            <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-accent">
              {category}
            </h3>
            <div class="flex flex-wrap gap-2.5">
              {skillList.map((skill) => (
                <span class="inline-flex items-center gap-2 rounded-lg border border-border bg-surface px-3 py-2 text-sm font-medium text-text-dark">
                  <span class="text-accent flex items-center"><Icon name={skill.iconName} size={16} /></span>
                  {skill.name}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- DevOps Pipeline Section -->
  <section class="py-24 px-6">
    <div class="container mx-auto max-w-6xl">
      <div class="text-center mb-16 reveal">
        <h2 class="text-3xl md:text-5xl font-bold mb-4">
          <span class="text-accent">{t.devOpsTitle.split(' ')[0]}</span>
          {' '}{t.devOpsTitle.split(' ').slice(1).join(' ')}
        </h2>
        <p class="text-lg text-text-muted">
          {t.devOpsDescription}
        </p>
      </div>

      <DevOpsPipeline client:load />
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="py-24 px-6">
    <div class="container mx-auto max-w-2xl text-center reveal">
      <h2 class="text-3xl md:text-5xl font-bold mb-6">
        <span class="text-accent">{t.contactTitle.split(' ')[0]}</span>
        {' '}{t.contactTitle.split(' ').slice(1).join(' ')}
      </h2>
      <p class="text-lg text-text-muted mb-10">
        {t.contactDescription}
      </p>

      <div class="flex flex-wrap gap-4 justify-center">
        {socials.map((social, index) => (
          <a
            href={social.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center w-full sm:w-fit gap-3 px-6 py-3 rounded-xl
                   bg-surface/50 backdrop-blur-sm border border-border/50
                   hover:border-accent/50 hover:bg-accent/10
                   transition-all duration-300 group animate-fade-in-up"
            style={`animation-delay: ${index * 0.1}s`}
          >
            <Icon name={social.iconName} size={20} class="text-accent" client:load />
            <span class="font-medium text-text-dark group-hover:text-accent transition-colors duration-300">{social.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  // Intersection Observer for reveal animations
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    },
    { threshold: 0.1 }
  );

  document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
</script>
