---
import Layout from '../../layouts/Layout.astro';
import {
  dictionary,
  projects,
  stack,
  socials,
  experience,
  cvLinks,
  locales,
  localeLabels,
  type Locale,
} from '../../constants/data';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = dictionary[lang];
---

<Layout title={t.metaTitle} description={t.metaDescription} lang={lang}>
  <div class="wrap">
    <main>
      <h1>@pippsza</h1>

      <div class="tabs ui">
        <span class="tabs-label">{t.bio}</span>
        <span class="tabs-right">
          <button type="button" class="on" data-bio="short" aria-pressed="true">{t.short}</button>
          <button type="button" data-bio="long" aria-pressed="false">{t.long}</button>
          <span class="sep" aria-hidden="true"></span>
          {locales.map((l) => (
            <a href={`/${l}/`} class={l === lang ? 'on' : undefined} hreflang={l} data-lang={l} aria-current={l === lang ? 'page' : undefined}>
              {localeLabels[l]}
            </a>
          ))}
        </span>
      </div>

      <div class="bio" data-bio="short">
        {t.bioShort.map((p) => <p set:html={p} />)}
      </div>
      <div class="bio" data-bio="long" hidden>
        {t.bioLong.map((p) => <p set:html={p} />)}
      </div>

      <h2>{t.projects}</h2>
      <div class="projects">
        {projects[lang].map((project) => (
          <section class="project">
            <a class="shot" href={project.link ?? project.github} tabindex="-1" aria-hidden="true">
              <img src={project.image} alt="" width="1200" height="750" loading="lazy" />
            </a>
            <div class="project-head">
              <h3><a href={project.link ?? project.github}>{project.title}</a></h3>
              <span class="ui year">2026</span>
            </div>
            <p>{project.description}</p>
            <div class="meta ui">
              <span>{project.tags.join(', ')}</span>
              <span class="icons">
                {project.link && (
                  <a class="icon" href={project.link} title={t.openSite} aria-label={t.openSite}>
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6" /><path d="M10 14 21 3" /><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /></svg>
                  </a>
                )}
                {project.github && (
                  <a class="icon" href={project.github} title={t.code} aria-label={t.code}>
                    <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" /></svg>
                  </a>
                )}
              </span>
            </div>
          </section>
        ))}
      </div>

      <h2>{t.stack}</h2>
      <ul class="stack">
        {stack.map((item) => <li>{item}</li>)}
      </ul>

      <h2 id="work">{t.work}</h2>
      <div class="work">
        {experience[lang].map((job) => (
          <div>
            <div>{job.company}<small>{job.position}</small></div>
            <span class="ui">{job.period}</span>
          </div>
        ))}
      </div>

      <p class="links">
        {socials.map((s) => (
          <>
            <a href={s.url}>{s.name}</a>,{' '}
          </>
        ))}
        <a href={cvLinks[lang]}>{t.cv}</a>
      </p>
    </main>

    <aside class="photo">
      <img src="/me.jpg" alt="Bohdan Astakhov" width="720" height="900" />
    </aside>
  </div>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('button[data-bio]');
  const bios = document.querySelectorAll<HTMLElement>('div.bio');
  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      buttons.forEach((b) => {
        const on = b === button;
        b.classList.toggle('on', on);
        b.setAttribute('aria-pressed', String(on));
      });
      bios.forEach((bio) => {
        bio.hidden = bio.dataset.bio !== button.dataset.bio;
      });
    });
  });

  // The root page redirects to the stored language
  document.querySelectorAll<HTMLAnchorElement>('a[data-lang]').forEach((a) => {
    a.addEventListener('click', () => localStorage.setItem('preferredLanguage', a.dataset.lang ?? 'en'));
  });
</script>

<style>
  .wrap {
    max-width: 1340px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 600px) 1fr;
    gap: 60px;
    padding: 44px 50px 100px;
  }

  h1 {
    font-size: 44px;
    margin: 0 0 36px;
    letter-spacing: -0.01em;
  }

  h2 {
    font-size: 24px;
    font-weight: 600;
    margin: 48px 0 16px;
  }

  .tabs {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    color: var(--muted);
    border-bottom: 1px solid #e8e8e8;
    margin-bottom: 22px;
  }

  .tabs-right {
    display: flex;
    gap: 16px;
  }

  .tabs-label,
  .tabs button,
  .tabs a {
    padding-bottom: 10px;
  }

  .tabs button,
  .tabs a {
    all: unset;
    cursor: pointer;
    padding-bottom: 10px;
    color: var(--muted);
  }

  .tabs button:hover,
  .tabs a:hover {
    color: var(--ink);
  }

  .tabs .on {
    color: var(--ink);
    box-shadow: inset 0 -1.5px 0 var(--ink);
  }

  .tabs .sep {
    width: 1px;
    background: #e2e2e2;
    margin: 2px 2px 12px;
    padding: 0;
  }

  .projects {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px 26px;
  }

  .project {
    display: flex;
    flex-direction: column;
    padding-bottom: 34px;
    min-width: 0;
  }

  .shot {
    display: block;
    margin-bottom: 14px;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid #e6e6e6;
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }

  .shot img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
  }

  .shot:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.1);
  }

  .project-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }

  .project h3 {
    font-size: 21px;
    margin: 0;
    overflow-wrap: anywhere;
  }

  .project h3 a {
    color: var(--ink);
  }

  .year {
    color: var(--muted);
  }

  .project p {
    flex-grow: 1;
    color: var(--soft);
    margin: 4px 0 12px;
    font-size: 16px;
    line-height: 1.5;
  }

  .meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    font-size: 13px;
    color: var(--muted);
  }

  .icons {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }

  .icon {
    display: inline-grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    border: 1px solid #e3e3e3;
    color: #555;
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }

  .icon:hover {
    color: #111;
    border-color: #bbb;
    background: #f6f6f4;
  }

  .stack {
    display: grid;
    grid-template-columns: 1fr 1fr;
    row-gap: 6px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .stack li::before {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    background: #888;
    margin: 0 14px 3px 0;
  }

  .work > div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    border-top: 1px solid var(--line);
    padding: 13px 0;
  }

  .work small {
    display: block;
    color: #7a7a7a;
    font-size: 16px;
    line-height: 1.4;
  }

  .work .ui {
    color: var(--muted);
    white-space: nowrap;
  }

  .links {
    margin-top: 36px;
  }

  .photo {
    position: sticky;
    top: 40px;
    align-self: start;
    display: flex;
    justify-content: flex-end;
  }

  .photo img {
    width: 420px;
    max-width: 100%;
    height: min(600px, calc(100vh - 80px));
    object-fit: cover;
    object-position: center 30%;
    border-radius: 10px;
    border: 1px solid #eee;
  }

  @media (max-width: 900px) {
    .wrap {
      display: flex;
      flex-direction: column;
      gap: 0;
      padding: 24px 20px 80px;
    }

    .photo {
      position: static;
      order: -1;
    }

    .photo img {
      width: 100%;
      height: auto;
      aspect-ratio: 4 / 5;
    }

    h1 {
      font-size: 36px;
      margin: 28px 0 24px;
    }

    .projects {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }

  @media (max-width: 520px) {
    .tabs-label {
      display: none;
    }

    .tabs,
    .tabs-right {
      width: 100%;
      justify-content: space-between;
    }

    .tabs-right {
      gap: 12px;
    }
  }
</style>
